{% macro testimonialSlide(text, author, position, logo = null, index = 0) %}
<div class="slide bg-white p-6 sm:p-8 rounded-lg shadow-md flex flex-col items-center text-center w-full">
  {% if logo %}
  <!-- Logo -->
  <div class="mb-6 flex-shrink-0 h-16 flex items-center">
    <img src="{{ logo }}" alt="" class="h-full w-auto object-contain">
  </div>
  {% else %}
  <!-- Circular Initial Placeholder -->
  <div class="w-16 h-16 rounded-full bg-blue-500 mb-6 flex-shrink-0 flex items-center justify-center">
    <span class="text-white text-xl font-bold">{{ author[0] | upper }}</span>
  </div>
  {% endif %}
  <!-- Quote Text -->
  <div class="flex-grow">
    <p class="text-gray-600 italic mb-6 break-words max-w-full sm:max-w-md md:max-w-lg leading-relaxed">{{ text | safe }}</p>
  </div>
  <div class="pt-4 w-full">
    <p class="text-gray-800 font-semibold">{{ author }}</p>
    {% if position %}
    <p class="text-gray-600 text-sm">{{ position | safe }}</p>
    {% endif %}
  </div>
</div>
{% endmacro %}

<!-- Testimonials Slider Component -->
<section id="testimonials" class="py-16 bg-gray-50">
<div class="container mx-auto px-6">
  <h2 class="text-3xl font-bold text-center text-gray-800 mb-12 font-heading">Was Kunden und Kundinnen sagen</h2>
  <!-- Relative container for slideshow with navigation -->
  <div class="relative max-w-3xl mx-auto">
    <div id="testimonial-container" class="css-slideshow-fade relative overflow-hidden">
      {{ testimonialSlide(
        'Zuzana zeigt stets großes Engagement und Empathie im Umgang mit den Kindern. Sie versteht es, individuelle Bedürfnisse zu erkennen und entsprechend zu handeln.<br><br>Ihre Fähigkeit, komplexe Situationen zu analysieren und passende Lösungen zu entwickeln, sind beeindruckend. Sie arbeitet stets zielorientiert und effektiv.<br><br>Zuzana ist eine wertvolle Teamkollegin. Sie kommuniziert offen und konstruktiv und trägt wesentlich zum Erfolg unserer gemeinsamen Projekte bei.<br><br><strong>Fazit:</strong> Ich kann Zuzana uneingeschränkt empfehlen. Sie ist eine engagierte und kompetente Fachkraft, die sich mit großem Erfolg um die Belange von Kindern mit Behinderungen kümmert.',
        'Petra Papai',
        'Teamleitung<br>FaBI – Mobile Familienbegleitung<br>Diakoniewerk Wien',
        '/assets/review/diakonie-logo.png',
        0
      ) }}
      
      {{ testimonialSlide(
        'Wir lernten Zuzana kennen im Zuge einer Betreuungssituation für unsere 13-jährige Tochter mit Beeinträchtigung.<br><br>Schon nach der ersten Einheit waren wir extrem positiv überrascht über die Empathie, die Zuzana unserer Tochter entgegenbrachte sowie ihr Engagement mit dem sie versuchte alle Situationen zu verstehen und mit uns gemeinsam zu reflektieren.<br><br>Zuzana begegnete unserer Tochter mit einer innerlichen Ruhe welche sich auch auf sie übertrug und die beiden harmonierten von Beginn an.<br><br>Wir haben bisher selten wirklich so positive Betreuungseinheiten gehabt. Unsere Tochter genießt bis jetzt die Betreuungssituationen und wir fühlen uns als gesamte Familie in den Prozeß miteinbezogen, können Vertrauen fassen und Zuzana nur weiterempfehlen.<br><br>Wir freuen uns sehr auf Zuzana gestoßen zu sein und empfinden ihre Person als Bereicherung für unser Familiensystem.',
        'Karin mit Flora',
        'Familie mit Tochter mit Beeinträchtigung',
        null,
        1
      ) }}

      {{ testimonialSlide(
        'Liebe Zuzana!<br><br>Frau hat sich heute gemeldet und dich sooooo sehr gelobt. Es ist schön, solche Nachrichten an einem Montag zu hören.<br><br>Danke für deine Hingabe und deine professionelle Arbeit! Ich bin froh, dich in meinem Team zu haben!<br><br>Liebe Grüße<br>Petra',
        'Petra Papai',
        'Teamleitung<br>FaBI – Mobile Familienbegleitung<br>Diakoniewerk Wien',
        '/assets/review/diakonie-logo.png',
        2
      ) }}

    </div>
    
    <!-- Navigation Arrows -->
    <button id="testimonial-prev" class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-white bg-opacity-80 hover:bg-opacity-100 rounded-full p-3 shadow-lg transition-all duration-200 z-20 group">
      <svg class="w-6 h-6 text-gray-600 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>
    
    <button id="testimonial-next" class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-white bg-opacity-80 hover:bg-opacity-100 rounded-full p-3 shadow-lg transition-all duration-200 z-20 group">
      <svg class="w-6 h-6 text-gray-600 group-hover:text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </button>
    
    <!-- Dots Navigation -->
    <div id="testimonial-dots" class="flex justify-center mt-6 space-x-2">
      <!-- Dots will be generated by JavaScript -->
    </div>
  </div>
</div>

<!-- Load the external testimonials.js file instead of inline script -->
<script src="/js/testimonials.js"></script>

</section> 
