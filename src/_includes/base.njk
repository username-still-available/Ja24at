<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{ description or metadata.description }}">
    <meta name="keywords" content="{{ keywords or metadata.keywords }}">
    <meta name="author" content="{{ author or metadata.author }}">
    <meta name="robots" content="index, follow">
    <!-- Prevent browser caching -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <meta property="og:title" content="{{ title or metadata.title }}">
    <meta property="og:description" content="{{ description or metadata.description }}">
    <meta property="og:image" content="{{ site.imagePrefix }}/assets/logo/Logo_24JA.png">
    <meta property="og:url" content="{{ metadata.baseUrl }}{{ page.url | url }}">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="24ja.at">
    <meta property="og:locale" content="de_AT">
    <link rel="canonical" href="{{ metadata.baseUrl }}{{ page.url | url }}">
    <title>{{ title or metadata.title }}</title>

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="/assets/favicon/site.webmanifest">
    <link rel="shortcut icon" href="/assets/favicon/favicon.ico">
    <meta name="theme-color" content="#228877">

    <!-- Critical CSS inlined for faster page rendering -->
    <style>
        /* Critical font definitions for Fira Sans */
        @font-face {
            font-family: 'Fira Sans';
            src: url('/fonts/Fira_Sans/FiraSans-Regular.ttf') format('truetype');
            font-weight: 400;
            font-style: normal;
            font-display: swap;
        }

        @font-face {
            font-family: 'Fira Sans';
            src: url('/fonts/Fira_Sans/FiraSans-Bold.ttf') format('truetype');
            font-weight: 700;
            font-style: normal;
            font-display: swap;
        }

        /* Basic Resets & Body */
        *, ::before, ::after { box-sizing: border-box; border-width: 0; border-style: solid; border-color: #e5e7eb; }
        html { line-height: 1.5; -webkit-text-size-adjust: 100%; tab-size: 4; font-family: 'Fira Sans', -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, Helvetica Neue, Arial, sans-serif; }
        body { margin: 0; line-height: inherit; background-color: #fff; font-family: 'Fira Sans', Arial, sans-serif; }
        
        /* Force all headings to use Fira Sans */
        h1, h2, h3, h4, h5, h6 { 
            font-size: inherit; 
            font-weight: inherit; /* Will be styled by Tailwind utilities or specific classes */
            font-family: 'Fira Sans', Arial, sans-serif !important;
        }
        
        .font-heading { /* This class can be used for emphasis if needed, otherwise headings are already Fira Sans */
            font-family: 'Fira Sans', Arial, sans-serif !important;
        }
        
        a { color: inherit; text-decoration: inherit; }
        img, video { max-width: 100%; height: auto; }
        /* Container Base */
        .container { width: 100%; margin-left: auto; margin-right: auto; padding-left: 1.5rem; padding-right: 1.5rem; }
        @media (min-width: 640px) { .container { max-width: 640px; } }
        @media (min-width: 768px) { .container { max-width: 768px; } }
        @media (min-width: 1024px) { .container { max-width: 1024px; } }
        @media (min-width: 1280px) { .container { max-width: 1280px; } }
        @media (min-width: 1536px) { .container { max-width: 1536px; } }
        /* Navigation */
        nav { background-color: #0A4835; padding-top: 1rem; padding-bottom: 1rem; padding-left: 1.5rem; padding-right: 1.5rem; box-shadow: 0 4px 6px -1px rgba(0,0,0,.1), 0 2px 4px -2px rgba(0,0,0,.1); position: sticky; top: 0; z-index: 50; height: 70px; }
        nav .container { display: flex; justify-content: space-between; align-items: center; height: 100%; }
        nav a.font-heading { font-size: 1.875rem; line-height: 2.25rem; font-weight: 700; color: #fff; font-family: 'Fira Sans', Arial, sans-serif !important; }
        /* Hero Section */
        header { position: relative; }
        header > div { background-color: #fff; color: #184435; }
        header .container { padding-top: 4rem; padding-bottom: 4rem; display: flex; flex-direction: column; align-items: center; text-align: center; }
        header h1 { font-size: 2.25rem; line-height: 2.5rem; font-weight: 700; color: #184435; margin-bottom: 1.5rem; font-family: 'Fira Sans', Arial, sans-serif !important; }
        header p { font-size: 1.25rem; line-height: 1.75rem; color: #184435; max-width: 42rem; margin-bottom: 2.5rem; }
        header a { display: inline-block; background-color: #184435; color: #fff; font-weight: 700; padding: 0.75rem 2rem; border-radius: 9999px; box-shadow: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -4px rgba(0,0,0,.1); }
        /* Responsive Hero Styles (Basic) */
        @media (min-width: 768px) {
            header .container { padding-top: 6rem; padding-bottom: 6rem; }
            header h1 { font-size: 3rem; line-height: 1; }
        }
        /* Add any other absolutely critical above-the-fold styles here */

        @keyframes wave {
            0% {
                transform: translateX(-1.5%) translateY(1%);
            }
            100% {
                transform: translateX(1.5%) translateY(-1%);
            }
        }
        .wave-animation {
            will-change: transform;
        }

        /* Heading text fix to prevent cut-off letters */
        .heading-container {
            line-height: 1.3;
            padding-bottom: 0.15em; /* Prevent cutting off descenders */
        }
    </style>

    <!-- Preload critical Fira Sans font -->
    <link rel="preload" href="/fonts/Fira_Sans/FiraSans-Regular.ttf" as="font" type="font/ttf" crossorigin>

    <!-- Load CSS synchronously -->
    <!-- Note: Path updated to reflect assets being served from root -->
    <link rel="stylesheet" href="/css/style.css?v={{ buildtime.timestamp }}">
    <!-- Async loading removed for style.css -->
    <!-- <link rel="preload" href="/css/style.css" as="style" onload="this.onload=null;this.rel='stylesheet'"> -->
    <!-- <noscript><link rel="stylesheet" href="/css/style.css"></noscript> -->

    <!-- Load fonts.css asynchronously (remains unchanged) -->
    <link rel="preload" href="/css/fonts.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="/css/fonts.css"></noscript>

    <!-- Fallback for browsers that don't support JS-loaded CSS -->
    <script>
        /* Critical polyfill for CSS loading */
        !function(n){"use strict";n.loadCSS||(n.loadCSS=function(){});var o=loadCSS.relpreload={};if(o.support=function(){var e;try{e=n.document.createElement("link").relList.supports("preload")}catch(t){e=!1}return function(){return e}}(),o.bindMediaToggle=function(t){var e=t.media||"all";function a(){t.addEventListener?t.removeEventListener("load",a):t.attachEvent&&t.detachEvent("onload",a),t.setAttribute("onload",null),t.media=e}t.addEventListener?t.addEventListener("load",a):t.attachEvent&&t.attachEvent("onload",a),setTimeout(function(){t.rel="stylesheet",t.media="only x"}),setTimeout(a,3e3)},o.poly=function(){if(!o.support())for(var t=n.document.getElementsByTagName("link"),e=0;e<t.length;e++){var a=t[e];"preload"!==a.rel||"style"!==a.getAttribute("as")||a.getAttribute("data-loadcss")||(a.setAttribute("data-loadcss",!0),o.bindMediaToggle(a))}},!o.support()){o.poly();var t=n.setInterval(o.poly,500);n.addEventListener?n.addEventListener("load",function(){o.poly(),n.clearInterval(t)}):n.attachEvent&&n.attachEvent("onload",function(){o.poly(),n.clearInterval(t)})}"undefined"!=typeof exports?exports.loadCSS=loadCSS:n.loadCSS=loadCSS}("undefined"!=typeof global?global:this);
    </script>

    <!-- REMOVED duplicate script tag -->
    <!-- <script src="/js/script.js" defer></script> -->

    <!-- Structured Data for SEO -->
    <!-- Consider moving this to _data/metadata.json or making parts dynamic -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "{{ metadata.structuredData.name }}",
      "image": "{{ metadata.structuredData.image }}",
      "url": "{{ metadata.baseUrl }}",
      "telephone": "{{ metadata.structuredData.telephone }}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{ metadata.structuredData.address.streetAddress }}",
        "addressLocality": "{{ metadata.structuredData.address.addressLocality }}",
        "postalCode": "{{ metadata.structuredData.address.postalCode }}",
        "addressCountry": "{{ metadata.structuredData.address.addressCountry }}"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": {{ metadata.structuredData.geo.latitude }},
        "longitude": {{ metadata.structuredData.geo.longitude }}
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": {{ metadata.structuredData.openingHoursSpecification.dayOfWeek | dump | safe }},
        "opens": "{{ metadata.structuredData.openingHoursSpecification.opens }}",
        "closes": "{{ metadata.structuredData.openingHoursSpecification.closes }}"
      },
      "sameAs": {{ metadata.structuredData.sameAs | dump | safe }},
      "priceRange": "{{ metadata.structuredData.priceRange }}",
      "description": "{{ description or metadata.description }}",
      "serviceArea": {
        "@type": "GeoCircle",
        "geoMidpoint": {
          "@type": "GeoCoordinates",
          "latitude": {{ metadata.structuredData.serviceArea.geoMidpoint.latitude }},
          "longitude": {{ metadata.structuredData.serviceArea.geoMidpoint.longitude }}
        },
        "geoRadius": {{ metadata.structuredData.serviceArea.geoRadius }}
      },
      "services": {{ metadata.structuredData.services | dump | safe }}
    }
    </script>

    <!-- Twitter Card data -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or metadata.title }}">
    <meta name="twitter:description" content="{{ description or metadata.description }}">
    <meta name="twitter:image" content="{{ site.imagePrefix }}/assets/logo/Logo_24JA.png">
    
    <!-- Additional SEO Meta Tags -->
    <meta name="geo.region" content="AT-9">
    <meta name="geo.placename" content="Wien">
    <meta name="geo.position" content="{{ metadata.structuredData.geo.latitude }};{{ metadata.structuredData.geo.longitude }}">
    <meta name="ICBM" content="{{ metadata.structuredData.geo.latitude }}, {{ metadata.structuredData.geo.longitude }}">
</head>
<body class="bg-white font-body m-0">
    {% if pageType != 'legal' %}
    <!-- Navigation Bar with white background - moved outside header to be sticky throughout the page -->
    <nav class="bg-brand-green py-4 px-6 shadow-md sticky top-0 z-50 h-[70px]">
        <div class="container mx-auto flex justify-between items-center h-full">
            <!-- Update link to point to root, replace text with logo -->
            <a href="/" class="flex items-center"> <!-- Use flex to align image if needed -->
                <img src="{{ site.imagePrefix }}/assets/logo/Logo_24JA.png" alt="24ja Logo" class="h-16 w-auto"> <!-- Adjusted from h-[17.5] to h-16 (64px) -->
            </a>
            <div class="hidden md:flex space-x-6">
                <a href="/#about" class="text-white hover:bg-white hover:text-brand-green px-3 py-2 rounded-md transition-colors duration-500">Meine Geschichte</a>
                <a href="/#services" class="text-white hover:bg-white hover:text-brand-green px-3 py-2 rounded-md transition-colors duration-500">Leistungen</a>
                <a href="/#contact" class="text-white hover:bg-white hover:text-brand-green px-3 py-2 rounded-md transition-colors duration-500">Kontakt</a>
            </div>
            <!-- Mobile Menu Button -->
            <button class="md:hidden text-white" id="mobile-menu-button">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>
    </nav>

    <!-- Mobile Menu (Hidden by default) -->
    <div class="md:hidden hidden bg-brand-green-light w-full fixed top-[4.375rem] z-40 shadow-md translate-z-0" id="mobile-menu">
        <div class="container mx-auto px-6 py-4 flex flex-col space-y-4">
            <a href="/#about" class="text-white hover:bg-white hover:text-brand-green px-3 py-2 rounded-md transition-colors duration-500">Meine Geschichte</a>
            <a href="/#services" class="text-white hover:bg-white hover:text-brand-green px-3 py-2 rounded-md transition-colors duration-500">Leistungen</a>
            <a href="/#contact" class="text-white hover:bg-white hover:text-brand-green px-3 py-2 rounded-md transition-colors duration-500">Kontakt</a>
        </div>
    </div>

    <!-- Hero Section with brand-green background -->
    <header class="relative">
        <!-- Hero Content with white background and diagonal accent -->
        <div class="bg-white text-brand-green relative overflow-hidden">
            <!-- Circle accent elements with pulsating animation -->
            <div class="absolute -right-16 -top-16 w-64 h-64 bg-brand-green opacity-[0.07] rounded-full animate-pulse-slow"></div>
            <div class="absolute -left-16 -bottom-16 w-64 h-64 bg-brand-green opacity-[0.07] rounded-full animate-pulse-slower"></div>
            
            <div class="container mx-auto px-6 py-16 md:py-24 flex flex-col items-center text-center relative z-10">
                <div class="heading-container">
                    <h1 class="text-2xl sm:text-3xl md:text-5xl font-bold text-brand-green mb-6 font-heading">Alltagsunterstützung für Ihre höhere Lebensqualität</h1>
                </div>
                <p class="text-xl text-brand-green max-w-2xl mb-10">
                    Der Ort, an dem sich im Leben Exzellenz und Leidenschaft treffen.
                </p>
                <a href="/#contact" class="bg-brand-green hover:bg-brand-green-light text-white font-bold py-3 px-8 rounded-full shadow-lg transition-colors">
                    Kontakt aufnehmen
                </a>
            </div>
            
            <!-- Wave divider for smooth transition to next section -->
            <div class="wave-divider relative h-24 -mb-1 overflow-hidden">
                <div class="wave-animation absolute inset-0 w-[104%] -left-[2%]" style="animation: wave 3.3s ease-in-out infinite alternate;">
                    <svg class="absolute bottom-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
                        <path fill="#184435" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,186.7C384,213,480,235,576,218.7C672,203,768,149,864,128C960,107,1056,117,1152,138.7C1248,160,1344,192,1392,208L1440,224L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
                    </svg>
                </div>
                <div class="wave-animation absolute inset-0 w-[104%] -left-[2%]" style="animation: wave 2.3s ease-in-out infinite alternate-reverse; opacity: 0.5;">
                    <svg class="absolute bottom-0 w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320" preserveAspectRatio="none">
                        <path fill="#184435" fill-opacity="1" d="M0,192L48,197.3C96,203,192,213,288,202.7C384,192,480,160,576,165.3C672,171,768,213,864,213.3C960,213,1056,171,1152,149.3C1248,128,1344,128,1392,128L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </header>
    {% endif %}

    {% if pageType == 'legal' %}
    <div class="container mx-auto px-6" style="padding-top: 3rem; padding-bottom: 1rem;">
        <a href="/" class="text-brand-green hover:underline">&larr; Zurück zur Startseite</a>
    </div>
    {% endif %}

    <!-- Main content area -->
    <main>
        {{ content | safe }}
    </main>

    {% if pageType == 'legal' %}
    <div class="container mx-auto px-6" style="padding-top: 2rem; padding-bottom: 2rem;">
        <a href="/" class="text-brand-green hover:underline">&larr; Zurück zur Startseite</a>
    </div>
    {% endif %}

    <!-- Footer -->
    <footer class="bg-brand-green text-white py-10">
        <div class="container mx-auto px-6">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="text-center md:text-left mb-6 md:mb-0">
                    <!-- Replace H3 text with logo -->
                    <img src="{{ site.imagePrefix }}/assets/logo/Logo_24JA.png" alt="24ja Logo" class="h-14 w-auto mx-auto md:mx-0"> <!-- Added mx-auto md:mx-0 for centering on mobile -->
                </div>

                <div class="text-center md:text-right">
                    <p class="text-gray-400">&copy; {% year %} 24ja - Macht das Leben leichter e.U.</p>
                    <div class="mt-2">
                        <!-- Update links to point to root -->
                        <a href="/impressum/" class="text-gray-400 hover:text-white mr-4">Impressum</a>
                        <a href="/datenschutz/" class="text-gray-400 hover:text-white">Datenschutz</a>
                    </div>
                    <p class="text-xs text-gray-500 mt-4">Mit ❤️ in Velden durch <a href="https://geschäftswebseite.at" target="_blank" rel="noopener" class="text-gray-500 hover:text-white underline">geschäftswebseite.at</a> programmiert und betreut.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/js/script.js" defer></script>
    <script src="/js/process-steps.js" defer></script>
    <script src="/js/testimonials.js" defer></script>
    <script src="/js/form-handler.js" defer></script>
    
    <!-- Cookie Banner -->
    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 shadow-md py-4 px-6 z-50 transition-transform duration-300 transform translate-y-0">
        <div class="container mx-auto px-4">
            <div class="flex flex-col sm:flex-row items-center justify-between">
                <div class="flex-1 mb-4 sm:mb-0 sm:mr-4">
                    <p class="text-gray-700 text-sm sm:text-base">
                        <span class="font-bold">Kein Cookie-Hinweis?</span> Diese Webseite verwendet keine Cookies - aber Zuzana liebt es, welche zu backen! 🍪
                    </p>
                </div>
                <div class="flex-shrink-0">
                    <button id="cookie-accept" class="bg-brand-green hover:bg-brand-green-light text-white font-medium py-2 px-4 rounded-md text-sm transition-colors duration-300">
                        Verstanden
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Cookie banner functionality
        document.addEventListener('DOMContentLoaded', function() {
            const cookieBanner = document.getElementById('cookie-banner');
            const acceptButton = document.getElementById('cookie-accept');
            const cookieAccepted = localStorage.getItem('cookie-notice-dismissed');
            
            if (!cookieAccepted && cookieBanner) {
                cookieBanner.style.display = 'block';
                
                if (acceptButton) {
                    acceptButton.addEventListener('click', function() {
                        cookieBanner.classList.add('transform', 'translate-y-full');
                        setTimeout(function() {
                            cookieBanner.style.display = 'none';
                        }, 300); // Match transition duration
                        localStorage.setItem('cookie-notice-dismissed', 'true');
                    });
                }
            } else if (cookieBanner) {
                cookieBanner.style.display = 'none';
            }
        });
    </script>
</body>
</html> 